# Database (Supabase PostgreSQL)
# Runtime: use the Transaction pooler URI (port 6543) for Vercel/serverless.
DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations: use the direct connection URI (port 5432).
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# YouTube
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID=""

# Email (Resend / SMTP)
EMAIL_FROM="noreply@alphafellowshipug.com"
RESEND_API_KEY=""

# WhatsApp (future Business API)
WHATSAPP_BUSINESS_NUMBER="+256707768708"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Alpha Fellowship Uganda"

# Seed (development only — change password after first deploy)
SEED_ADMIN_EMAIL="admin@alphafellowshipug.com"
