# Database (Neon PostgreSQL)
# Runtime: use the pooled connection string (host contains "-pooler") for Vercel/serverless.
DATABASE_URL="postgresql://[user]:[password]@[host]-pooler.[region].aws.neon.tech/[db]?sslmode=require"
# Migrations/seed: use the unpooled direct connection string.
DIRECT_URL="postgresql://[user]:[password]@[host].[region].aws.neon.tech/[db]?sslmode=require"
# Neon/Vercel also expose this alias — either DIRECT_URL or DATABASE_URL_UNPOOLED works.
# DATABASE_URL_UNPOOLED="postgresql://..."

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# YouTube (enable YouTube Data API v3 in Google Cloud; key must allow server-side use)
YOUTUBE_API_KEY=""
# Channel ID (UC...) or handle (@alphabfellowship). Alpha Fellowship: UCFQ3S1UouA2OPlPZLISnbXA
YOUTUBE_CHANNEL_ID="UCFQ3S1UouA2OPlPZLISnbXA"

# Email (Resend)
EMAIL_FROM="noreply@alphafellowshipug.com"
RESEND_API_KEY=""
ADMIN_NOTIFICATION_EMAIL="alphabfellowship7@gmail.com"

# WhatsApp (future Business API)
